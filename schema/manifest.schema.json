{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kekeeya/TypePalMaker/schema/manifest.schema.json",
  "title": "TypePal pet manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "id",
    "display",
    "frames",
    "states"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,40}$"
    },
    "display": {
      "type": "object",
      "required": [
        "height"
      ],
      "properties": {
        "height": {
          "type": "number",
          "minimum": 32,
          "maximum": 1024
        }
      }
    },
    "canvas": {
      "type": "object",
      "description": "Maker only: the canvas every frame is drawn into (pixels, dpi). The runtime ignores it.",
      "required": [
        "width",
        "height",
        "dpi"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "dpi": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "speech": {
      "type": "object",
      "description": "The speech bubble, for every line the pet says; each part as designed when absent. Unusable values are ignored, numbers pulled into range.",
      "properties": {
        "offsetX": { "type": "number", "minimum": -2, "maximum": 2, "description": "From its usual place centred over the head, as a share of the pet's height; to the right. The tail still points at the head." },
        "offsetY": { "type": "number", "minimum": -2, "maximum": 2, "description": "As offsetX, downwards." },
        "bubbleColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "The bubble and its tail; #FFFDF7 by default." },
        "textColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "The line; #353754 by default." },
        "fontSize": { "type": "number", "minimum": 10, "maximum": 24, "description": "Points; 13 by default. Line height and the longest line grow with it." },
        "bubbleSize": { "type": "number", "minimum": 0.6, "maximum": 2, "description": "Padding and corner radius against the design's; 1 by default." }
      }
    },
    "iconStyle": {
      "type": "object",
      "description": "Maker only: how icon.png is placed on the app icon (offsets in 512-px icon units, scale and rotation about the icon's centre, background colour). The runtime ignores it.",
      "properties": {
        "background": {
          "type": "string"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "offsetX": {
          "type": "number"
        },
        "offsetY": {
          "type": "number"
        },
        "rotation": {
          "type": "number"
        }
      }
    },
    "frames": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string"
          }
        }
      }
    },
    "states": {
      "type": "object",
      "required": [
        "idle"
      ],
      "properties": {
        "idle": {
          "$ref": "#/$defs/state"
        },
        "typing": {
          "$ref": "#/$defs/state"
        },
        "mouseClick": {
          "$ref": "#/$defs/state"
        },
        "tap": {
          "$ref": "#/$defs/state"
        },
        "pet": {
          "$ref": "#/$defs/state"
        },
        "sleep": {
          "$ref": "#/$defs/state"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "required": [
        "enabled",
        "fps",
        "loop",
        "frames"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "loop": {
          "type": "boolean",
          "description": "Informational: the runtime loops idle and sleep and plays every other state once per trigger, whatever this says."
        },
        "sleepAfterMinutes": {
          "type": "number",
          "description": "Sleep only: minutes without input before the pet falls asleep. 15 when absent.",
          "exclusiveMinimum": 0,
          "maximum": 1440
        },
        "tracks": {
          "type": "array",
          "description": "Rows played together on one clock, the first drawn over the others. When present, the runtime plays these and `frames` holds the pet's own row, for readers that know only one.",
          "items": {
            "type": "object",
            "required": ["id", "name", "frames"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string" },
              "frames": {
                "type": "array",
                "items": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "required": ["id"],
                      "properties": {
                        "id": { "type": "string" },
                        "duration": { "type": "number", "exclusiveMinimum": 0 },
                        "delay": { "type": "number", "minimum": 0 },
                        "scale": { "type": "number", "exclusiveMinimum": 0 },
                        "offsetX": { "type": "number" },
                        "offsetY": { "type": "number" },
                        "rotation": { "type": "number" }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "frames": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "duration": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Milliseconds; overrides 1/fps for this frame"
                  },
                  "delay": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Milliseconds its row shows nothing before this frame (an effect that comes in later); 0 when absent"
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Maker placement: scale of the fitted picture; baked into the picture when the app is generated"
                  },
                  "offsetX": {
                    "type": "number",
                    "description": "Maker placement: horizontal offset in canvas pixels; baked on generation"
                  },
                  "offsetY": {
                    "type": "number",
                    "description": "Maker placement: vertical offset in canvas pixels; baked on generation"
                  },
                  "rotation": {
                    "type": "number",
                    "description": "Maker placement: rotation in degrees about the picture's bottom centre; baked on generation"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
